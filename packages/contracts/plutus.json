    "veridict/types/BountyDatum": {
      "title": "BountyDatum",
      "description": "Everything the validator needs to police a bounty.\n\n Note `oracle_key` is a raw 32-byte Ed25519 public key, not a key hash: the\n validator verifies a signature over the verdict digest directly, which\n requires the key itself.",
      "anyOf": [
        {
          "title": "BountyDatum",
          "dataType": "constructor",
          "index": 0,
          "fields": [
            {
              "title": "poster",
              "$ref": "#/definitions/aiken~1crypto~1VerificationKeyHash"
            },
            {
              "title": "oracle_key",
              "$ref": "#/definitions/ByteArray"
            },
            {
              "title": "arbiter",
              "$ref": "#/definitions/aiken~1crypto~1VerificationKeyHash"
            },
            {
              "title": "treasury",
              "$ref": "#/definitions/aiken~1crypto~1VerificationKeyHash"
            },
            {
              "title": "criteria_hash",
              "$ref": "#/definitions/ByteArray"
            },
            {
              "title": "reward_policy",
              "$ref": "#/definitions/cardano~1assets~1PolicyId"
            },
            {
              "title": "reward_name",
              "$ref": "#/definitions/cardano~1assets~1AssetName"
            },
            {
              "title": "reward_amount",
              "description": "Lovelace actually staked by the poster and held in this UTxO.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "reward_usd_micro",
              "description": "The bounty's real denomination: USD scaled by 1,000,000, so $50 is\n 50_000_000. The payout is computed from this at the oracle price when the\n verdict resolves, which is why a poster can advertise a dollar amount\n without carrying ADA volatility between posting and completion.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "price_scale",
              "description": "The feed's own scaling factor, declared here rather than assumed, so a\n change in feed precision cannot silently change what a bounty pays.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "oracle_policy",
              "description": "NFT identifying the oracle feed UTxO. An address can be imitated; a token\n under the oracle's own policy cannot.",
              "$ref": "#/definitions/cardano~1assets~1PolicyId"
            },
            {
              "title": "oracle_name",
              "$ref": "#/definitions/cardano~1assets~1AssetName"
            },
            {
              "title": "deadline",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "appeal_window_ms",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "protocol_fee_bps",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "oracle_key_version",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "state",
              "$ref": "#/definitions/veridict~1types~1BountyState"
            }
          ]
        }
      ]
    },
