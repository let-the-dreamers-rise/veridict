# Veridict environment template. Copy to .env and fill in.
# Never commit .env. Never place real keys in this file.

# --- Cardano ---
CARDANO_NETWORK=Preprod
BLOCKFROST_PROJECT_ID=preprod_replace_me
BLOCKFROST_URL=https://cardano-preprod.blockfrost.io/api/v0

# --- Oracle signing key (Ed25519, hex-encoded 32-byte seed) ---
# Production: inject from a secret manager, never from a file.
ORACLE_SIGNING_KEY_HEX=
ORACLE_KEY_VERSION=1

# --- Database ---
DATABASE_URL=postgresql://veridict:veridict@localhost:5432/veridict

# --- Redis / queues ---
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=4000
API_HOST=0.0.0.0
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Sandbox ---
SANDBOX_IMAGE=veridict/sandbox@sha256:replace_me
SANDBOX_TIMEOUT_MS=120000
SANDBOX_MEMORY_MB=512
SANDBOX_CPUS=1

# --- Reasoning engine (bounded judgment criteria) ---
JUDGMENT_PROVIDER=anthropic
JUDGMENT_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_NETWORK=Preprod
NEXT_PUBLIC_EXPLORER_URL=https://preprod.cardanoscan.io
